# Application
NODE_ENV=development
PORT=3000

# Access tokens
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=7

# Optional: first admin bootstrap (leave both empty to disable).
# If no admin exists, the service creates this account or promotes an existing
# user with this email. Change the password before deploying.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
